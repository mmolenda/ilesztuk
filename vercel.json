{
  "headers": [
    {
      "source": "/k/:calculatorId",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/regulamin", "destination": "/regulamin.html" },
    { "source": "/polityka-prywatnosci", "destination": "/polityka-prywatnosci.html" },
    { "source": "/k/:calculatorId", "destination": "/index.html" }
  ]
}
