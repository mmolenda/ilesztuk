{
  "customerId": "ilesztuk-demo",
  "customerName": "IleSztuk Demo",
  "calculatorId": "On8NNerB5hxA",
  "calculatorName": "Formatki meblowe - oklejenie od 15 cm",
  "plugin": "rectangular_pieces",
  "configuration": {
    "displayUnit": "cm",
    "purchasableUnitLabel": "sztuk",
    "dimensions": {
      "first": { "key": "length", "label": "Długość" },
      "second": { "key": "width", "label": "Szerokość" },
      "noteOrder": ["length", "width"]
    },
    "pricing": {
      "areaUnit": "cm2",
      "mode": "divide_by_area_per_item",
      "areaPerItemCm2": 100
    },
    "purchasableQuantity": {
      "rounding": { "mode": "round", "precision": 0 }
    },
    "edges": {
      "enabled": true,
      "default": ["top", "right", "bottom", "left"],
      "minCoatedEdgeCm": 15
    },
    "constraints": {
      "minDimensionCm": 1,
      "maxPerimeterCm": 460,
      "enforceSecondNotGreaterThanFirst": false
    }
  }
}
